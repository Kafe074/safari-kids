# Copia este archivo como application.properties y completa tus valores

server.port=8080

spring.datasource.url=jdbc:mysql://localhost:3306/safari_kids?useSSL=false&serverTimezone=America/Lima&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=TU_PASSWORD_AQUI
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

app.jwt.secret=CambiarEsteSecretoPorUnoSeguro123456789!
app.jwt.expiration=86400000

app.cors.allowed-origins=http://localhost:5173
app.frontend-url=http://localhost:5173

# ─── Correo (Gmail SMTP) ────────────────────────────────────────────────────────
# 1. Usa una cuenta de Gmail y activa la verificación en 2 pasos.
# 2. Genera una "contraseña de aplicación" en https://myaccount.google.com/apppasswords
#    y pégala (16 caracteres, sin espacios) en spring.mail.password.
# 3. spring.mail.username es la dirección completa de esa cuenta de Gmail.
# Si dejas username/password vacíos, los correos simplemente no se envían.
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=tucorreo@gmail.com
spring.mail.password=
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
app.mail.from-name=Safari Kids

# ─── Telegram (avisos internos al personal) ─────────────────────────────────────
# 1. Habla con @BotFather en Telegram, /newbot, y copia el token aquí.
# 2. Crea un grupo, agrega tu bot, y obtén el chat_id (ver instrucciones abajo).
#    Para un grupo el id es negativo (ej: -1001234567890).
# Si dejas estos valores vacíos, los avisos simplemente no se envían.
telegram.bot-token=
telegram.chat-id=

logging.level.com.safarikids=DEBUG
logging.level.org.springframework.security=INFO
